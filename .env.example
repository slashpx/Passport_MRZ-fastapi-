# ======================================================
# MRZ Backend Environment Variables
# Copy to .env and fill in values before deploying
# ======================================================

# Server port
PORT=5000

# --- SECURITY ---
# A random high-entropy secret shared between Zuplo and this backend.
# Zuplo injects this header; backend rejects any request without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_SECRET=your_random_secret_here

# --- PAYPAL ---
# Get credentials from: https://developer.paypal.com/dashboard/applications
# Use PAYPAL_MODE=sandbox for testing, then switch to live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# PayPal Subscription Plan IDs (create in PayPal Dashboard > Products & Plans)
PAYPAL_PLAN_STARTER=your_starter_plan_id
PAYPAL_PLAN_PRO=your_pro_plan_id
PAYPAL_PLAN_ENTERPRISE=your_enterprise_plan_id

# --- ZUPLO ---
# Get from: Settings -> Zuplo API Keys
ZUPLO_API_KEY=YOUR_ZUPLO_API_KEY
# Your Zuplo project name/ID
ZUPLO_PROJECT_ID=mrz-api-main
# Usually 'production' or 'dev'
ZUPLO_BUCKET_NAME=production

# --- TESSERACT (Linux/Docker) ---
# Usually auto-detected; uncomment to override
# TESSERACT_PATH=/usr/bin/tesseract

# --- AI SERVICES ---
OPENAI_API_KEY=your_openai_api_key_here
AI_FALLBACK_ENABLED=true
AI_CONFIDENCE_THRESHOLD=95

# --- NODE ---
NODE_ENV=production
